<div class="trust-row">
  {%- for i in (1..3) -%}
    {%- liquid
      assign icon_key = 'icon' | append: i
      assign label_key = 'label' | append: i
      assign icon = section.settings[icon_key]
      assign label = section.settings[label_key]
    -%}
    {%- if label != blank -%}
      <div class="trust-row__item">
        {%- case icon -%}
          {%- when 'shield' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
          {%- when 'drop' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2s7 8 7 13a7 7 0 1 1-14 0c0-5 7-13 7-13Z"/></svg>
          {%- when 'truck' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8Z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          {%- when 'refresh' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          {%- when 'lock' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9Z"/><path d="M2 9h20"/><path d="M8 9l4 12 4-12"/></svg>
        {%- endcase -%}
        {{ label }}
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Trust Badges (Top)",
  "settings": [
    { "type": "select", "id": "icon1", "label": "Icon 1", "default": "diamond", "options": [
      { "value": "diamond", "label": "Diamond" }, { "value": "shield", "label": "Shield" }, { "value": "drop", "label": "Drop" },
      { "value": "truck", "label": "Truck" }, { "value": "refresh", "label": "Refresh" }, { "value": "lock", "label": "Lock" }
    ] },
    { "type": "text", "id": "label1", "label": "Label 1", "default": "Premium Quality" },
    { "type": "select", "id": "icon2", "label": "Icon 2", "default": "shield", "options": [
      { "value": "diamond", "label": "Diamond" }, { "value": "shield", "label": "Shield" }, { "value": "drop", "label": "Drop" },
      { "value": "truck", "label": "Truck" }, { "value": "refresh", "label": "Refresh" }, { "value": "lock", "label": "Lock" }
    ] },
    { "type": "text", "id": "label2", "label": "Label 2", "default": "Tarnish Free" },
    { "type": "select", "id": "icon3", "label": "Icon 3", "default": "drop", "options": [
      { "value": "diamond", "label": "Diamond" }, { "value": "shield", "label": "Shield" }, { "value": "drop", "label": "Drop" },
      { "value": "truck", "label": "Truck" }, { "value": "refresh", "label": "Refresh" }, { "value": "lock", "label": "Lock" }
    ] },
    { "type": "text", "id": "label3", "label": "Label 3", "default": "Skin Friendly" }
  ]
}
{% endschema %}
