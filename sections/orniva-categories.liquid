<!-- ========================= Shop by category ========================= -->
<section class="categories">
  <div class="container">
    <div class="section-heading">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="categories__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign category_title = block.settings.title | default: block.settings.collection.title | default: 'Category'
          assign category_url = block.settings.collection.url | default: '#'
        -%}
        <div class="category-item" {{ block.shopify_attributes }}>
          <div class="category-item__media ph-img ph-img--soft">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 200 }}"
                alt="{{ category_title | escape }}"
                loading="lazy"
                width="200"
                height="{{ 200 | divided_by: block.settings.image.aspect_ratio | default: 200 }}"
              >
            {%- elsif block.settings.collection.featured_image != blank -%}
              <img
                src="{{ block.settings.collection.featured_image | image_url: width: 200 }}"
                alt="{{ category_title | escape }}"
                loading="lazy"
                width="200"
                height="{{ 200 | divided_by: block.settings.collection.featured_image.aspect_ratio | default: 200 }}"
              >
            {%- else -%}
              {%- case block.settings.icon -%}
                {%- when 'necklace' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4c0 6 3.5 10 8 10s8-4 8-10"/><circle cx="12" cy="17" r="3"/></svg>
                {%- when 'earring' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="6" r="2"/><path d="M12 8v3"/><path d="M8 11a4 4 0 0 0 8 0"/></svg>
                {%- when 'bracelet' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/></svg>
                {%- when 'ring' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="15" r="6"/><path d="M9 9l3-6 3 6"/></svg>
                {%- when 'mangalsutra' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v6a6 6 0 0 0 12 0V4"/><circle cx="12" cy="18" r="2.5"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l1.6 6.4L20 10l-6.4 1.6L12 18l-1.6-6.4L4 10l6.4-1.6Z"/></svg>
              {%- endcase -%}
            {%- endif -%}
          </div>
          <div class="category-item__name">{{ category_title | upcase }}</div>
          <a href="{{ category_url }}" class="category-item__link" aria-label="Shop {{ category_title }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Orniva Categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop By Category" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Optional. Links this tile to a real collection and pulls its title/image when set." },
        { "type": "text", "id": "title", "label": "Title override", "info": "Optional. Defaults to the collection's title." },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "info": "Used only when no custom image is set below.",
          "options": [
            { "value": "necklace", "label": "Necklace" },
            { "value": "earring", "label": "Earring" },
            { "value": "bracelet", "label": "Bracelet" },
            { "value": "ring", "label": "Ring" },
            { "value": "mangalsutra", "label": "Mangalsutra" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "sparkle"
        },
        { "type": "image_picker", "id": "image", "label": "Custom image", "info": "Optional. Overrides the icon and the collection's image." }
      ]
    }
  ],
  "max_blocks": 12,
  "default": {
    "settings": {
      "heading": "Shop By Category"
    },
    "blocks": [
      { "type": "category", "settings": { "title": "Necklaces", "icon": "necklace" } },
      { "type": "category", "settings": { "title": "Earrings", "icon": "earring" } },
      { "type": "category", "settings": { "title": "Bracelets", "icon": "bracelet" } },
      { "type": "category", "settings": { "title": "Rings", "icon": "ring" } },
      { "type": "category", "settings": { "title": "Mangalsutra", "icon": "mangalsutra" } },
      { "type": "category", "settings": { "title": "Collections", "icon": "sparkle" } }
    ]
  }
}
{% endschema %}
