<!-- ========================= Why choose Orniva ========================= -->
<section class="why-us">
  <div class="container why-us__inner">
    <div class="why-us__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="why-us__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    <div class="why-us__grid">
      {%- for block in section.blocks -%}
        <div class="why-us__item" {{ block.shopify_attributes }}>
          {%- case block.settings.icon -%}
            {%- when 'sparkle' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l1.6 6.4L20 10l-6.4 1.6L12 18l-1.6-6.4L4 10l6.4-1.6Z"/></svg>
            {%- when 'drop' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2s7 8 7 13a7 7 0 1 1-14 0c0-5 7-13 7-13Z"/></svg>
            {%- when 'clock' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9Z"/><path d="M2 9h20"/><path d="M8 9l4 12 4-12"/></svg>
          {%- endcase -%}
          {%- if block.settings.title != blank -%}
            <h4>{{ block.settings.title }}</h4>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p>{{ block.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Orniva Why Us",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "NEW CHOOSE ORNIVA?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed to Make You Shine" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "diamond", "label": "Diamond" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "drop", "label": "Drop" },
            { "value": "clock", "label": "Clock" }
          ],
          "default": "diamond"
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "max_blocks": 6,
  "default": {
    "settings": {
      "eyebrow": "NEW CHOOSE ORNIVA?",
      "heading": "Designed to Make You Shine"
    },
    "blocks": [
      {
        "type": "feature",
        "settings": {
          "icon": "diamond",
          "title": "Premium Quality",
          "description": "Carefully selected materials for a luxurious feel."
        }
      },
      {
        "type": "feature",
        "settings": {
          "icon": "sparkle",
          "title": "Tarnish Free",
          "description": "Advanced coating for long lasting shine."
        }
      },
      {
        "type": "feature",
        "settings": {
          "icon": "drop",
          "title": "Skin Friendly",
          "description": "Nickel free & hypoallergenic. Safe for all skin types."
        }
      },
      {
        "type": "feature",
        "settings": {
          "icon": "clock",
          "title": "Trusted by Thousands",
          "description": "Loved by 10,000+ happy customers across India."
        }
      }
    ]
  }
}
{% endschema %}
