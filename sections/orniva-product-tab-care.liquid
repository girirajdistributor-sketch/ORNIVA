{%- liquid
  assign checklist_lines = section.settings.checklist_items | newline_to_br | split: '<br />'
-%}
<div class="tabs__panel" id="tab-care" role="tabpanel">
  <div>
    {%- if section.settings.intro_text != blank -%}
      <p>{{ section.settings.intro_text }}</p>
    {%- endif -%}
    {%- if section.settings.checklist_items != blank -%}
      <ul class="check-list">
        {%- for line in checklist_lines -%}
          {%- assign trimmed_line = line | strip -%}
          {%- if trimmed_line != blank -%}
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> {{ trimmed_line }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
  <div class="spec-box">
    {%- if section.settings.spec_avoid != blank -%}
      <div class="spec-row"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2s7 8 7 13a7 7 0 1 1-14 0c0-5 7-13 7-13Z"/></svg> <span><strong>Avoid:</strong> {{ section.settings.spec_avoid }}</span></div>
    {%- endif -%}
    {%- if section.settings.spec_store != blank -%}
      <div class="spec-row"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4"/><path d="M12 8v13"/><path d="M19 12v7a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-7"/></svg> <span><strong>Store:</strong> {{ section.settings.spec_store }}</span></div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product Tab: Care Guide",
  "settings": [
    { "type": "textarea", "id": "intro_text", "label": "Intro text", "default": "A little care keeps the shine looking new for years. Follow these simple steps to protect your jewellery." },
    { "type": "textarea", "id": "checklist_items", "label": "Checklist items (one per line)", "default": "Keep away from water, perfume & sweat\nStore in the pouch provided, away from sunlight\nWipe gently with a soft, dry cloth after each wear\nPut it on last, take it off first" },
    { "type": "text", "id": "spec_avoid", "label": "Avoid value", "default": "Water & perfume" },
    { "type": "text", "id": "spec_store", "label": "Store value", "default": "In pouch, dry place" }
  ]
}
{% endschema %}
