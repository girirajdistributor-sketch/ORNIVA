{%- liquid
  assign products_source = section.settings.collection.products | default: collections.all.products
  assign button_url = section.settings.button_link | default: section.settings.collection.url | default: routes.all_products_collection_url
-%}

<!-- ========================= Best sellers ========================= -->
<section class="product-section">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading"><h2>{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="product-carousel">
      <div class="product-carousel__track">
        {%- for product in products_source limit: section.settings.products_to_show -%}
          {%- render 'orniva-product-card', product: product -%}
        {%- endfor -%}
      </div>
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="product-section__cta">
        <a href="{{ button_url }}" class="btn btn-primary">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Orniva Best Sellers",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Optional. Leave blank to pull from your full catalog." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 5 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View All Products" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Optional. Defaults to the selected collection, or all products." }
  ]
}
{% endschema %}
