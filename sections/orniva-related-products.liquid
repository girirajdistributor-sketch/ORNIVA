<div
  class="container related-products"
  data-related-products
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related"
>
  <div class="section-heading"><h2>{{ section.settings.heading }}</h2></div>
  <div class="product-carousel">
    <div class="product-carousel__track">
      {%- if recommendations.performed -%}
        {%- for related in recommendations.products -%}
          {%- render 'orniva-product-card', product: related -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Orniva Related Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 5 }
  ]
}
{% endschema %}
