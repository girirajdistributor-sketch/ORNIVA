<div class="info-box">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8Z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
  <div>
    {%- if section.settings.heading != blank -%}
      <strong>{{ section.settings.heading }}</strong>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <span class="sub-note">{{ section.settings.subtext }}</span>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.show_cod and section.settings.cod_text != blank -%}
  <div class="info-box info-box--cod">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01"/><path d="M18 12h.01"/></svg>
    <div>
      <strong>{{ section.settings.cod_text }}</strong>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Delivery Info",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Estimated Delivery: 2–4 business days" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Free Shipping on orders above ₹999" },
    { "type": "checkbox", "id": "show_cod", "label": "Show Cash on Delivery badge", "default": true },
    { "type": "text", "id": "cod_text", "label": "COD text", "default": "Cash on Delivery (COD) Available" }
  ]
}
{% endschema %}
