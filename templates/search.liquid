<!-- ========================= Breadcrumb ========================= -->
<nav class="breadcrumb" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li>&rsaquo;</li>
      <li aria-current="page">Search</li>
    </ol>
  </div>
</nav>

<section class="search-page">
  <div class="container">
    <div class="search-page__header">
      <h1>Search</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
        <input type="hidden" name="type" value="product">
        <label for="search-page-input" class="visually-hidden">Search products</label>
        <input
          type="search"
          id="search-page-input"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Search products&hellip;"
          autofocus
        >
        <button type="submit" aria-label="Submit search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="search-page__count">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for &ldquo;{{ search.terms }}&rdquo;</p>

        {%- paginate search.results by 12 -%}
          <div class="product-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {%- render 'orniva-product-card', product: item -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          <nav class="pagination" aria-label="Search results pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" aria-label="Previous page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <button type="button" class="is-active" aria-current="page">{{ part.title }}</button>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" aria-label="Next page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></a>
            {%- endif -%}
          </nav>
        {%- endpaginate -%}
      {%- else -%}
        <div class="search-page__empty">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <p>No results found for &ldquo;{{ search.terms }}&rdquo;.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Browse All Products</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="search-page__empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <p>Enter a search term above to find products.</p>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .search-page {
    padding-block: 40px 60px;
  }

  .search-page__header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 32px;
  }

  .search-page__header h1 {
    font-size: 2rem;
    margin-bottom: 20px;
  }

  .search-page__form {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    padding: 4px 4px 4px 16px;
  }

  .search-page__form input[type="search"] {
    flex: 1;
    border: none;
    background: transparent;
    padding: 10px 8px;
    font-family: inherit;
    font-size: 0.95rem;
  }

  .search-page__form input[type="search"]:focus {
    outline: none;
  }

  .search-page__form button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    color: var(--color-text-light);
    flex-shrink: 0;
  }

  .search-page__form button:hover {
    color: var(--color-gold);
  }

  .search-page__form button svg {
    width: 18px;
    height: 18px;
  }

  .search-page__count {
    text-align: center;
    color: var(--color-text-light);
    font-size: 0.9rem;
    margin-bottom: 28px;
  }

  .search-page__empty {
    text-align: center;
    padding: 60px 0;
    color: var(--color-text-light);
  }

  .search-page__empty svg {
    width: 56px;
    height: 56px;
    stroke: var(--color-gold);
    margin-bottom: 20px;
  }

  .search-page__empty p {
    margin-bottom: 20px;
    font-size: 1rem;
  }
</style>
