<!-- ========================= Breadcrumb ========================= -->
<nav class="breadcrumb" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li>&rsaquo;</li>
      {%- if product.collections.first -%}
        <li><a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a></li>
        <li>&rsaquo;</li>
      {%- endif -%}
      <li aria-current="page">{{ product.title }}</li>
    </ol>
  </div>
</nav>

<!-- ========================= Product main ========================= -->
<main class="product-main">
  {%- form 'product', product, id: 'orniva-product-form' -%}
  <div class="container product-layout">

    <!-- Gallery -->
    <div class="gallery">
      <div class="gallery__thumbs">
        {%- for media in product.media limit: 8 -%}
          <button class="gallery__thumb{% if forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}" aria-label="View image {{ forloop.index }}">
            <img src="{{ media | image_url: width: 150 }}" alt="{{ media.alt | default: product.title | escape }}" width="150" height="150" loading="lazy">
          </button>
        {%- endfor -%}
      </div>

      <div class="gallery__main">
        {%- if product.compare_at_price > product.price -%}
          <span class="gallery__badge">Sale</span>
        {%- elsif product.tags contains 'best-seller' -%}
          <span class="gallery__badge">Best Seller</span>
        {%- endif -%}
        <button class="gallery__wishlist" aria-label="Add to wishlist" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        </button>
        {%- for media in product.media limit: 8 -%}
          <img
            class="gallery__main-image{% if forloop.first %} is-active{% endif %}"
            data-media-id="{{ media.id }}"
            src="{{ media | image_url: width: 800 }}"
            alt="{{ media.alt | default: product.title | escape }}"
            width="800"
            height="{{ 800 | divided_by: media.aspect_ratio | default: 800 }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          >
        {%- endfor -%}
        <div class="gallery__nav">
          <button class="gallery__prev" aria-label="Previous image" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></button>
          <button class="gallery__next" aria-label="Next image" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></button>
        </div>
      </div>
    </div>

    <!-- Product info -->
    <div class="product-info">
      <h1>{{ product.title }}</h1>

      <div class="product-info__rating">
        <span class="rating__stars">
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <svg class="is-empty" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </span>
        (24 reviews)
      </div>

      <div class="product-info__price">
        <span class="price-now">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="price-old">{{ product.compare_at_price | money }}</span>
          <span class="discount-badge">{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% OFF</span>
        {%- endif -%}
      </div>

      {% section 'orniva-trust-badges-top' %}

      {% section 'orniva-delivery-info' %}

      {%- assign option1 = product.options_with_values[0] -%}
      {%- if option1 -%}
        <div class="option-block">
          <div class="option-block__label">{{ option1.name }}: <span>{{ product.selected_or_first_available_variant.option1 }}</span></div>
          <div class="color-swatches">
            {%- for value in option1.values -%}
              <button
                type="button"
                class="color-swatch{% if product.selected_or_first_available_variant.option1 == value %} is-selected{% endif %}"
                data-option-value="{{ value | escape }}"
                style="--swatch-color: {{ value | handle }};"
                aria-label="{{ value }}"
                aria-pressed="{% if product.selected_or_first_available_variant.option1 == value %}true{% else %}false{% endif %}"
              ><span></span></button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      <input type="hidden" name="id" id="orniva-selected-variant-id" value="{{ product.selected_or_first_available_variant.id }}">

      <div class="qty-row">
        <div class="option-block__label" style="margin:0;">Quantity:</div>
        <div class="qty-stepper">
          <button class="qty-decrease" aria-label="Decrease quantity" type="button">&minus;</button>
          <input type="number" name="quantity" value="1" min="1" max="10" inputmode="numeric" aria-label="Quantity" />
          <button class="qty-increase" aria-label="Increase quantity" type="button">&plus;</button>
        </div>
        <div class="stock-status"><span class="dot"></span> {% if product.selected_or_first_available_variant.available %}In Stock{% else %}Out of Stock{% endif %}</div>
      </div>

      <div class="product-actions">
        <button type="submit" name="add" class="btn btn-primary btn-block"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          Add To Cart
        </button>
        {{ form | payment_button }}
      </div>

      {% section 'orniva-trust-badges-bottom' %}
    </div>
  </div>
  {%- endform -%}

  <!-- Tabs -->
  <div class="container">
    <div class="product-tabs">
      <div class="tabs__nav" role="tablist">
        <button class="is-active" data-tab="tab-description" role="tab" aria-selected="true">Description</button>
        <button data-tab="tab-details" role="tab" aria-selected="false">Product Details</button>
        <button data-tab="tab-shipping" role="tab" aria-selected="false">Shipping &amp; Returns</button>
        <button data-tab="tab-care" role="tab" aria-selected="false">Care Guide</button>
      </div>

      {% section 'orniva-product-tab-description' %}
      {% section 'orniva-product-tab-details' %}
      {% section 'orniva-product-tab-shipping' %}
      {% section 'orniva-product-tab-care' %}
    </div>
  </div>

  <!-- Related products -->
  <div class="container related-products">
    <div class="section-heading"><h2>You May Also Like</h2></div>
    <div class="product-carousel">
      <div class="product-carousel__track">
        {%- for related in product.recommendations limit: 5 -%}
          {%- render 'orniva-product-card', product: related -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</main>
