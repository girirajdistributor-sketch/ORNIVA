<!-- ========================= Breadcrumb ========================= -->
<nav class="breadcrumb" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li>&rsaquo;</li>
      <li aria-current="page">{{ collection.title }}</li>
    </ol>
  </div>
</nav>

{% section 'orniva-collection-banner' %}

<!-- ========================= Listing ========================= -->
<section class="listing">
  <div class="container">
    <form method="get" action="{{ collection.url }}" class="filters-form">
      <button type="button" class="filters-toggle" aria-expanded="false" aria-controls="filters">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/><circle cx="9" cy="6" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="9" cy="18" r="2"/></svg>
        Filter By
      </button>

      <div class="listing__inner">
        <!-- Sidebar filters — wired to Shopify's real collection filters -->
        <aside class="filters" id="filters">
          <div class="filters__title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/><circle cx="9" cy="6" r="2"/><circle cx="15" cy="12" r="2"/><circle cx="9" cy="18" r="2"/></svg>
            Filter By
          </div>

          {%- for filter in collection.filters -%}
            {%- if filter.type == 'price_range' -%}
              <div class="filter-group">
                <div class="filter-group__heading">{{ filter.label }}</div>
                <div class="price-range">
                  <input
                    type="range"
                    name="{{ filter.max_value.param_name }}"
                    min="{{ filter.range_min | divided_by: 100 }}"
                    max="{{ filter.range_max | divided_by: 100 }}"
                    value="{{ filter.max_value.value | default: filter.range_max | divided_by: 100 }}"
                    aria-label="Maximum price"
                    onchange="this.form.submit()"
                  />
                  <div class="price-range__values">
                    <span>{{ filter.range_min | money }}</span>
                    <span>{{ filter.max_value.value | default: filter.range_max | money }}</span>
                  </div>
                </div>
              </div>
            {%- elsif filter.values.size > 0 -%}
              <div class="filter-group">
                <div class="filter-group__heading">{{ filter.label }}</div>
                {%- for value in filter.values -%}
                  <label class="filter-option">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      {% if value.count == 0 and value.active == false %}disabled{% endif %}
                      onchange="this.form.submit()"
                    />
                    <span>{{ value.label }}</span>
                    <small>({{ value.count }})</small>
                  </label>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- if collection.filters.size > 0 -%}
            <a href="{{ collection.url }}" class="filters__clear">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
              Clear All
            </a>
          {%- endif -%}
        </aside>

        <!-- Product grid -->
        <div class="listing__content">
          {%- paginate collection.products by 12 -%}
          <div class="listing__toolbar">
            <div>Showing {{ paginate.current_offset | plus: 1 }}&ndash;{{ paginate.current_offset | plus: paginate.page_size | at_most: paginate.items }} of {{ paginate.items }} products</div>
            <div class="listing__toolbar-right">
              <div class="sort-select">
                <label for="sort" class="visually-hidden">Sort by</label>
                Sort by:
                <select id="sort" name="sort_by" onchange="this.form.submit()">
                  <option value="manual"{% if collection.sort_by == 'manual' %} selected{% endif %}>Featured</option>
                  <option value="price-ascending"{% if collection.sort_by == 'price-ascending' %} selected{% endif %}>Price: Low to High</option>
                  <option value="price-descending"{% if collection.sort_by == 'price-descending' %} selected{% endif %}>Price: High to Low</option>
                  <option value="created-descending"{% if collection.sort_by == 'created-descending' %} selected{% endif %}>Newest</option>
                  <option value="best-selling"{% if collection.sort_by == 'best-selling' %} selected{% endif %}>Best Rated</option>
                </select>
              </div>
              <div class="view-toggle">
                <button type="button" class="is-active" aria-label="Grid view" aria-pressed="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg></button>
                <button type="button" aria-label="List view" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></button>
              </div>
            </div>
          </div>

          <div class="product-grid">
            {%- for product in collection.products -%}
              {%- render 'orniva-product-card', product: product -%}
            {%- endfor -%}
          </div>

          <nav class="pagination" aria-label="Product list pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" aria-label="Previous page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <button type="button" class="is-active" aria-current="page">{{ part.title }}</button>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" aria-label="Next page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></a>
            {%- endif -%}
          </nav>
          {%- endpaginate -%}
        </div>
      </div>
    </form>
  </div>
</section>
