<!-- ========================= Breadcrumb ========================= -->
<nav class="breadcrumb" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li>&rsaquo;</li>
      <li aria-current="page">Cart</li>
    </ol>
  </div>
</nav>

<section class="cart-page">
  <div class="container">
    <h1 class="cart-page__heading">Shopping Cart</h1>

    {%- if cart.item_count == 0 -%}
      <div class="cart-page__empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <p>Your cart is empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Continue Shopping</a>
      </div>
    {%- else -%}
      {%- form 'cart', cart, class: 'cart-page__form' -%}
        <div class="cart-page__layout">
          <div class="cart-page__items">
            <div class="cart-page__items-head">
              <span>Product</span>
              <span>Price</span>
              <span>Quantity</span>
              <span>Total</span>
            </div>
            {%- for item in cart.items -%}
              <div class="cart-page__item">
                <div class="cart-page__item-product">
                  <a href="{{ item.url }}" class="cart-page__item-image">
                    {%- if item.image -%}
                      <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="100" height="100" loading="lazy">
                    {%- endif -%}
                  </a>
                  <div class="cart-page__item-info">
                    <a href="{{ item.url }}" class="cart-page__item-title">{{ item.product.title }}</a>
                    {%- unless item.variant.title == 'Default Title' -%}
                      <div class="cart-page__item-variant">{{ item.variant.title }}</div>
                    {%- endunless -%}
                    <a href="{{ item.url_to_remove }}" class="cart-page__item-remove">Remove</a>
                  </div>
                </div>
                <div class="cart-page__item-price" data-label="Price">{{ item.final_price | money }}</div>
                <div class="cart-page__item-qty" data-label="Quantity">
                  <div class="qty-stepper">
                    <button type="button" class="qty-decrease" aria-label="Decrease quantity">&minus;</button>
                    <input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="Quantity">
                    <button type="button" class="qty-increase" aria-label="Increase quantity">&plus;</button>
                  </div>
                </div>
                <div class="cart-page__item-total" data-label="Total">{{ item.final_line_price | money }}</div>
              </div>
            {%- endfor -%}
            <button type="submit" name="update" class="btn btn-outline">Update Cart</button>
          </div>

          <div class="cart-page__summary">
            <h2>Order Summary</h2>
            <div class="cart-page__summary-row">
              <span>Subtotal</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            {%- if cart.total_discount > 0 -%}
              <div class="cart-page__summary-row cart-page__summary-row--discount">
                <span>Discount</span>
                <span>&minus;{{ cart.total_discount | money }}</span>
              </div>
            {%- endif -%}
            <p class="cart-page__summary-note">Shipping, taxes, and discounts calculated at checkout.</p>

            <label for="cart-note" class="cart-page__note-label">Order note</label>
            <textarea id="cart-note" name="note" class="cart-page__note" placeholder="Add a note to your order">{{ cart.note }}</textarea>

            <button type="submit" name="checkout" class="btn btn-primary btn-block">Checkout</button>
            <a href="{{ routes.all_products_collection_url }}" class="cart-page__continue">Continue Shopping</a>
          </div>
        </div>
      {%- endform -%}
    {%- endif -%}
  </div>
</section>

<style>
  /* ==========================================================================
     Cart page styles (inlined so this page's design never depends on a
     separately-synced asset file)
     ========================================================================== */

  .cart-page {
    padding-block: 40px 60px;
  }

  .cart-page__heading {
    font-size: 2rem;
    margin-bottom: 32px;
  }

  /* ---------- Empty state ---------- */
  .cart-page__empty {
    text-align: center;
    padding: 80px 0;
    color: var(--color-text-light);
  }

  .cart-page__empty svg {
    width: 64px;
    height: 64px;
    stroke: var(--color-gold);
    margin-bottom: 20px;
  }

  .cart-page__empty p {
    margin-bottom: 24px;
    font-size: 1rem;
  }

  /* ---------- Layout ---------- */
  .cart-page__layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 40px;
    align-items: start;
  }

  /* ---------- Items ---------- */
  .cart-page__items {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 24px;
  }

  .cart-page__items-head,
  .cart-page__item {
    display: grid;
    grid-template-columns: 2.4fr 1fr 1.2fr 1fr;
    align-items: center;
    gap: 16px;
  }

  .cart-page__items-head {
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-light);
  }

  .cart-page__item {
    padding-block: 20px;
  }

  .cart-page__item + .cart-page__item {
    border-top: 1px solid var(--color-border);
  }

  .cart-page__item-product {
    display: flex;
    gap: 16px;
  }

  .cart-page__item-image {
    width: 90px;
    height: 90px;
    border-radius: var(--radius-md);
    overflow: hidden;
    flex-shrink: 0;
    background: var(--color-bg-alt);
    display: block;
  }

  .cart-page__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-page__item-info {
    min-width: 0;
  }

  .cart-page__item-title {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 4px;
    color: var(--color-text);
  }

  .cart-page__item-variant {
    font-size: 0.82rem;
    color: var(--color-text-light);
    margin-bottom: 8px;
  }

  .cart-page__item-remove {
    font-size: 0.78rem;
    color: var(--color-text-light);
    text-decoration: underline;
  }

  .cart-page__item-remove:hover {
    color: var(--color-sale);
  }

  .cart-page__item-price,
  .cart-page__item-total {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .cart-page .qty-stepper {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    width: fit-content;
  }

  .cart-page .qty-stepper button {
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    color: var(--color-text-light);
    background: none;
    border: none;
  }

  .cart-page .qty-stepper button:hover {
    color: var(--color-gold);
  }

  .cart-page .qty-stepper input {
    width: 40px;
    text-align: center;
    border: none;
    border-inline: 1px solid var(--color-border);
    height: 34px;
    font-weight: 600;
  }

  .cart-page__items > .btn {
    margin-top: 16px;
  }

  /* ---------- Summary ---------- */
  .cart-page__summary {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 24px;
    background: var(--color-bg-alt);
  }

  .cart-page__summary h2 {
    font-size: 1.1rem;
    margin-bottom: 16px;
  }

  .cart-page__summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
    margin-bottom: 10px;
  }

  .cart-page__summary-row--discount {
    color: var(--color-success);
  }

  .cart-page__summary-note {
    font-size: 0.78rem;
    color: var(--color-text-light);
    margin-bottom: 20px;
  }

  .cart-page__note-label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .cart-page__note {
    width: 100%;
    min-height: 80px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    padding: 10px 12px;
    font-family: inherit;
    font-size: 0.85rem;
    margin-bottom: 16px;
    resize: vertical;
  }

  .cart-page__summary .btn {
    order: 1;
    margin-bottom: 12px;
  }

  .cart-page__continue {
    order: 2;
    display: block;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text-light);
    text-decoration: underline;
  }

  .cart-page__continue:hover {
    color: var(--color-gold);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .cart-page__layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .cart-page__items-head {
      display: none;
    }

    .cart-page__item {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .cart-page__item-price,
    .cart-page__item-qty,
    .cart-page__item-total {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .cart-page__item-price::before,
    .cart-page__item-qty::before,
    .cart-page__item-total::before {
      content: attr(data-label);
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--color-text-light);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".cart-page__item-qty .qty-stepper").forEach((stepper) => {
      const input = stepper.querySelector("input");
      const decreaseBtn = stepper.querySelector(".qty-decrease");
      const increaseBtn = stepper.querySelector(".qty-increase");

      decreaseBtn?.addEventListener("click", () => {
        input.value = Math.max(0, parseInt(input.value, 10) - 1);
      });

      increaseBtn?.addEventListener("click", () => {
        input.value = parseInt(input.value, 10) + 1;
      });
    });
  });
</script>
