<div class="coming-soon">
  <div class="coming-soon__inner">
    <div class="coming-soon__logo">
      {%- if settings.logo != blank -%}
        <img
          src="{{ settings.logo | image_url: width: 180 }}"
          alt="{{ shop.name | escape }}"
          width="180"
          height="{{ 180 | divided_by: settings.logo.aspect_ratio | default: 60 }}"
        >
      {%- else -%}
        <span class="coming-soon__logo-mark">{{ shop.name | default: 'ORNIVA' }}</span>
      {%- endif -%}
    </div>

    <span class="coming-soon__eyebrow">&#10022; COMING SOON &#10022;</span>
    <h1>Something Beautiful Is On Its Way</h1>
    <p>We're putting the finishing touches on our new store. Sign up below and be the first to know when we launch.</p>

    {%- form 'customer', class: 'coming-soon__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="coming-soon__success">Thanks! We'll let you know the moment we launch.</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter,coming-soon">
        <label class="visually-hidden" for="coming-soon-email">Email address</label>
        <input id="coming-soon-email" type="email" name="contact[email]" placeholder="Enter your email address" required>
        <button type="submit" class="btn btn-primary">Notify Me</button>
        {%- if form.errors -%}
          <p class="coming-soon__error">{{ form.errors.messages['email'] | default: 'Please enter a valid email address.' }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}

    <div class="coming-soon__socials">
      <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
      <a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3Z"/></svg></a>
      <a href="#" aria-label="Pinterest"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21c1-3 1.5-5 2-8"/><path d="M12 3a9 9 0 1 0 3.6 17.25c-1.4-.3-2.6-1.2-3-2.6a4.3 4.3 0 0 1 .2-2.7l1-4a2.5 2.5 0 0 1 5 .3c0 1.6-1 3.7-1.6 5.2A2 2 0 0 0 19 19"/></svg></a>
    </div>

    <details class="coming-soon__owner-login">
      <summary>Store owner? Log in here</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <p class="coming-soon__error">Wrong password, please try again.</p>
        {%- endif -%}
        <label class="visually-hidden" for="coming-soon-password">Password</label>
        <input type="password" id="coming-soon-password" name="password" placeholder="Password" autocomplete="current-password">
        <button type="submit" class="btn btn-outline">Enter</button>
      {%- endform -%}
    </details>
  </div>
</div>

<style>
  body {
    background: var(--color-bg);
  }

  .coming-soon {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
  }

  .coming-soon__inner {
    width: 100%;
    max-width: 520px;
    text-align: center;
  }

  .coming-soon__logo {
    margin-bottom: 28px;
  }

  .coming-soon__logo img {
    display: inline-block;
    max-width: 180px;
    max-height: 60px;
    width: auto;
    height: auto;
  }

  .coming-soon__logo-mark {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-gold);
    letter-spacing: 0.08em;
  }

  .coming-soon__eyebrow {
    display: block;
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    color: var(--color-gold);
    margin-bottom: 16px;
  }

  .coming-soon h1 {
    font-size: 2.2rem;
    margin-bottom: 16px;
  }

  .coming-soon p {
    color: var(--color-text-light);
    margin-bottom: 32px;
  }

  .coming-soon__form {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-bottom: 36px;
  }

  .coming-soon__form input[type="email"] {
    flex: 1;
    min-width: 220px;
    padding: 14px 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.9rem;
    background: var(--color-surface);
  }

  .coming-soon__success {
    color: var(--color-success);
    font-weight: 600;
  }

  .coming-soon__error {
    width: 100%;
    color: var(--color-sale);
    font-size: 0.82rem;
    margin-top: 8px;
  }

  .coming-soon__socials {
    display: flex;
    justify-content: center;
    gap: 18px;
    margin-bottom: 32px;
  }

  .coming-soon__socials a {
    display: inline-flex;
    color: var(--color-text-light);
    transition: var(--transition);
  }

  .coming-soon__socials a:hover {
    color: var(--color-gold);
  }

  .coming-soon__socials svg {
    width: 20px;
    height: 20px;
  }

  .coming-soon__owner-login {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .coming-soon__owner-login summary {
    cursor: pointer;
    text-decoration: underline;
  }

  .coming-soon__owner-login form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-top: 16px;
  }

  .coming-soon__owner-login input[type="password"] {
    padding: 10px 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.85rem;
  }

  @media (max-width: 480px) {
    .coming-soon h1 {
      font-size: 1.7rem;
    }
  }
</style>
