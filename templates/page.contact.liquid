<!-- ========================= Breadcrumb ========================= -->
<nav class="breadcrumb" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li>&rsaquo;</li>
      <li aria-current="page">{{ page.title }}</li>
    </ol>
  </div>
</nav>

<section class="contact-page">
  <div class="container">
    <div class="contact-page__intro">
      <h1>{{ page.title }}</h1>
      {%- if page.content != blank -%}
        <div class="contact-page__content">{{ page.content }}</div>
      {%- else -%}
        <p>We'd love to hear from you. Reach out with questions about an order, a product, or anything else &mdash; our team typically replies within 24&ndash;48 hours.</p>
      {%- endif -%}
    </div>

    <div class="contact-page__layout">
      <div class="contact-page__info">
        <div class="contact-page__info-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2Z"/><polyline points="22 6 12 13 2 6"/></svg>
          <div>
            <strong>Email</strong>
            <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>
          </div>
        </div>
        <div class="contact-page__info-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8Z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <div>
            <strong>Shipping</strong>
            <span>Free shipping on orders above &#8377;999, across India</span>
          </div>
        </div>
        <div class="contact-page__info-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/></svg>
          <div>
            <strong>Response Time</strong>
            <span>We reply within 24&ndash;48 business hours</span>
          </div>
        </div>

        <div class="contact-page__socials">
          <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
          <a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3Z"/></svg></a>
          <a href="#" aria-label="Pinterest"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21c1-3 1.5-5 2-8"/><path d="M12 3a9 9 0 1 0 3.6 17.25c-1.4-.3-2.6-1.2-3-2.6a4.3 4.3 0 0 1 .2-2.7l1-4a2.5 2.5 0 0 1 5 .3c0 1.6-1 3.7-1.6 5.2A2 2 0 0 0 19 19"/></svg></a>
        </div>
      </div>

      <div class="contact-page__form-wrap">
        {%- form 'contact', class: 'contact-page__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="contact-page__success">Thanks for reaching out! We'll get back to you soon.</p>
          {%- else -%}
            {%- if form.errors -%}
              <p class="contact-page__error">Please correct the errors below and try again.</p>
            {%- endif -%}

            <div class="contact-page__row">
              <div class="contact-page__field">
                <label for="ContactName">Name</label>
                <input type="text" id="ContactName" name="contact[name]" value="{{ form.name }}" required>
              </div>
              <div class="contact-page__field">
                <label for="ContactEmail">Email</label>
                <input
                  type="email"
                  id="ContactEmail"
                  name="contact[email]"
                  value="{{ form.email }}"
                  autocomplete="email"
                  {%- if form.errors contains 'email' %} aria-invalid="true"{% endif %}
                  required
                >
              </div>
            </div>

            <div class="contact-page__field">
              <label for="ContactPhone">Phone (optional)</label>
              <input type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
            </div>

            <div class="contact-page__field">
              <label for="ContactMessage">Message</label>
              <textarea id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
            </div>

            <button type="submit" class="btn btn-primary">Send Message</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

<style>
  .contact-page {
    padding-block: 40px 60px;
  }

  .contact-page__intro {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 48px;
  }

  .contact-page__intro h1 {
    font-size: 2.2rem;
    margin-bottom: 14px;
  }

  .contact-page__intro p,
  .contact-page__content {
    color: var(--color-text-light);
  }

  .contact-page__layout {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 48px;
    align-items: start;
  }

  .contact-page__info {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .contact-page__info-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .contact-page__info-item svg {
    width: 22px;
    height: 22px;
    stroke: var(--color-gold);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .contact-page__info-item strong {
    display: block;
    font-size: 0.9rem;
    margin-bottom: 4px;
  }

  .contact-page__info-item a,
  .contact-page__info-item span {
    font-size: 0.85rem;
    color: var(--color-text-light);
  }

  .contact-page__info-item a:hover {
    color: var(--color-gold);
  }

  .contact-page__socials {
    display: flex;
    gap: 16px;
    padding-top: 8px;
    border-top: 1px solid var(--color-border);
  }

  .contact-page__socials a {
    display: inline-flex;
    color: var(--color-text-light);
    transition: var(--transition);
  }

  .contact-page__socials a:hover {
    color: var(--color-gold);
  }

  .contact-page__socials svg {
    width: 18px;
    height: 18px;
  }

  .contact-page__form-wrap {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 32px;
    background: var(--color-surface);
  }

  .contact-page__form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .contact-page__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .contact-page__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact-page__field label {
    font-size: 0.82rem;
    font-weight: 600;
  }

  .contact-page__field input,
  .contact-page__field textarea {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    font-family: inherit;
    font-size: 0.9rem;
    background: var(--color-bg);
    resize: vertical;
  }

  .contact-page__field input:focus,
  .contact-page__field textarea:focus {
    outline: none;
    border-color: var(--color-gold);
  }

  .contact-page__success {
    color: var(--color-success);
    font-weight: 600;
  }

  .contact-page__error {
    color: var(--color-sale);
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .contact-page__layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .contact-page__row {
      grid-template-columns: 1fr;
    }
  }
</style>
