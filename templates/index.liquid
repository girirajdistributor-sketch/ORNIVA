      </div>
      <div class="category-item">
        <div class="category-item__media ph-img ph-img--soft"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2l1.6 6.4L20 10l-6.4 1.6L12 18l-1.6-6.4L4 10l6.4-1.6Z"/></svg></div>
